# Copy to .env and edit. .env is git-ignored and must never be committed (SR-08).

VERIFACT_ENVIRONMENT=dev

# SQLite needs no services and is the default for development and tests.
# Postgres (used by docker compose):
#   VERIFACT_DATABASE_URL=postgresql+psycopg://verifact:verifact@db:5432/verifact
VERIFACT_DATABASE_URL=sqlite+pysqlite:///./verifact.db

# Auth. Startup FAILS if auth is enabled with no keys, rather than serving open.
VERIFACT_API__AUTH_ENABLED=false
# VERIFACT_API__API_KEYS=["replace-me-with-a-real-key"]
VERIFACT_API__RATE_LIMIT_PER_MINUTE=60

VERIFACT_LOG__LEVEL=INFO
VERIFACT_LOG__JSON_FORMAT=true

# Set true to run entirely from the local snapshot with no outbound requests (NFR-05).
VERIFACT_RETRIEVAL__OFFLINE=false

# "auto" uses transformer backends when the `ml` extra is installed and falls
# back to the lexical backends otherwise. Force one with "transformer"/"lexical".
VERIFACT_VERIFICATION__BACKEND=auto
VERIFACT_RETRIEVAL__BACKEND=auto
VERIFACT_EXTRACTION__BACKEND=auto
